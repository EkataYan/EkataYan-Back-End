SUPABASE_URL=https://your-project.supabase.co
# Use a publishable key or legacy anon key, NEVER a service-role key here.
SUPABASE_KEY=
# Reserved for future trusted jobs. Not used by user-facing requests.
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL: omit this entire AI block to run without itinerary generation.
# Configure all three AI_* values together to enable the OpenAI-compatible provider.
# AI_PROVIDER is optional and defaults to openai_compatible.
# AI_PROVIDER=openai_compatible
# AI_PROVIDER=gemini
# AI_API_KEY=your-provider-api-key
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-flash
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model-name
WEATHER_PROVIDER=weatherapi
WEATHER_API_KEY=
FLASK_ENV=development
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
PORT=5000
