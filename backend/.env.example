SUPABASE_URL=https://your-project.supabase.co
# Use a publishable key or legacy anon key, NEVER a service-role key here.
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use SUPABASE_ANON_KEY instead. SUPABASE_KEY remains accepted for compatibility.
# OPTIONAL: the app and non-AI routes boot without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Keep this below the Gunicorn timeout in Procfile.
GEMINI_TIMEOUT_SECONDS=60
WEATHER_PROVIDER=weatherapi
WEATHER_API_KEY=
FLASK_ENV=development
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Railway injects PORT automatically; this value is for local development.
PORT=5000
