SUPABASE_URL=https://your-project.supabase.co
# Use a publishable key or legacy anon key, NEVER a service-role key here.
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use SUPABASE_ANON_KEY instead. SUPABASE_KEY remains accepted for compatibility.
# OPTIONAL: omit this entire AI block to run without itinerary generation.
# Configure all three AI_* values together to enable itinerary generation.
# AI_PROVIDER is optional and defaults to openai_compatible.
# AI_PROVIDER=openai_compatible
# AI_PROVIDER=gemini
# AI_API_KEY=your-provider-api-key
# Gemini uses the native Interactions API at AI_BASE_URL/interactions.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_MODEL=gemini-3.5-flash-lite
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model-name
WEATHER_PROVIDER=weatherapi
WEATHER_API_KEY=
FLASK_ENV=development
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Railway injects PORT automatically; this value is for local development.
PORT=5000
